{
  "name": "@engducation/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./schema/auth": {
      "types": "./src/schema/auth.ts",
      "default": "./src/schema/auth.ts"
    },
    "./schema/content": {
      "types": "./src/schema/content.ts",
      "default": "./src/schema/content.ts"
    },
    "./schema/index": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:full-reset": "tsx src/scripts/reset.ts && tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/utils": "catalog:",
    "@engducation/env": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "ws": "^8.20.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@engducation/config": "workspace:*",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
