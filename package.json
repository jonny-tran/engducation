{
  "name": "engducation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.development -- turbo dev",
    "build": "node -e \"const fs = require('fs'); const cp = require('child_process'); if (fs.existsSync('.env.development')) { cp.execSync('dotenv -e .env.development -- turbo build', { stdio: 'inherit' }); } else { cp.execSync('turbo build', { stdio: 'inherit' }); }\"",
    "check-types": "turbo check-types",
    "dev:web": "dotenv -e .env.development -- turbo -F web dev",
    "dev:server": "dotenv -e .env.development -- turbo -F server dev",
    "db:push:dev": "dotenv -e .env.development -- turbo -F @engducation/db db:push",
    "db:studio:dev": "dotenv -e .env.development -- turbo -F @engducation/db db:studio",
    "db:generate": "dotenv -e .env.development -- turbo -F @engducation/db db:generate",
    "db:migrate:prod": "dotenv -e .env.production -- turbo -F @engducation/db db:migrate",
    "db:full-reset:dev": "dotenv -e .env.development -- turbo -F @engducation/db db:reset && dotenv -e .env.development -- turbo -F @engducation/db db:push && dotenv -e .env.development -- turbo -F @engducation/db db:seed",
    "db:reset:dev": "dotenv -e .env.development -- turbo -F @engducation/db db:reset",
    "db:seed:dev": "dotenv -e .env.development -- turbo -F @engducation/db db:seed"
  },
  "dependencies": {
    "@engducation/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@engducation/config": "workspace:*",
    "@types/node": "^22.13.14",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.9.14",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.28.2"
}
